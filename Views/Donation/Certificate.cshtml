@model GiftOfTheGivers.Models.Donation

@{
    ViewData["Title"] = "Donation Tax Certificate";
}

<div class="container mt-5">
    <div class="card shadow">
        <div class="card-body">

            <div class="text-center">
                <h1 class="mb-4">
                    Gift of the Givers
                </h1>

                <h2>
                    Donation Tax Certificate
                </h2>

                <p class="text-muted">
                    Disaster Relief and Humanitarian Support
                </p>
            </div>

            <hr />

            <div class="row mt-4">
                <div class="col-sm-6">
                    <strong>Certificate Number:</strong>
                    <p>@Model.TaxCertificateNumber</p>
                </div>

                <div class="col-sm-6">
                    <strong>Issue Date:</strong>
                    <p>
                        @Model.TaxCertificateIssuedAt?.ToString("dd MMMM yyyy")
                    </p>
                </div>

                <div class="col-sm-6">
                    <strong>Donor:</strong>
                    <p>@Model.TaxCertificateDonorName</p>
                </div>

                <div class="col-sm-6">
                    <strong>Email:</strong>
                    <p>@Model.TaxCertificateDonorEmail</p>
                </div>

                <div class="col-sm-6">
                    <strong>Donation Amount:</strong>
                    <p>
                        @Model.Currency @Model.Amount.ToString("N2")
                    </p>
                </div>

                <div class="col-sm-6">
                    <strong>Donation Type:</strong>
                    <p>@Model.DonationType</p>
                </div>

                <div class="col-sm-6">
                    <strong>Donation Date:</strong>
                    <p>
                        @Model.DonationDate.ToString("dd MMMM yyyy")
                    </p>
                </div>

                <div class="col-sm-6">
                    <strong>Reference Number:</strong>
                    <p>@Model.ReferenceNumber</p>
                </div>
            </div>

            <div class="alert alert-success text-center mt-4">
                Thank you for supporting Gift of the Givers.
            </div>

            <div class="text-center mt-4">
                <button onclick="window.print()"
                        class="btn btn-dark">
                    Print / Save Certificate
                </button>
            </div>

        </div>
    </div>
</div>

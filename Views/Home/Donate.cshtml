                    </div>
                </div>

                <!-- Account 2: Zakaat -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <h5 class="fw-bold text-success">Gift of the Givers Foundation <span class="badge bg-warning text-dark">Zakaat Account</span></h5>
                        <div class="row">
                            <div class="col-sm-6"><strong>Account Number:</strong> 052278611</div>
                            <div class="col-sm-6"><strong>Bank:</strong> Standard Bank</div>
                            <div class="col-sm-6"><strong>Universal Code:</strong> 051001</div>
                            <div class="col-sm-6"><strong>SWIFT Code:</strong> SBZAZAJJ</div>
                        </div>
                    </div>
                </div>

                <!-- Account 3: EUR -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <h5 class="fw-bold text-success">Gift of the Givers Foundation <span class="badge bg-info">EUR</span></h5>
                        <div class="row">
                            <div class="col-sm-6"><strong>Account Number:</strong> 090710355</div>
                            <div class="col-sm-6"><strong>Bank:</strong> Standard Bank</div>
                            <div class="col-sm-6"><strong>Type:</strong> Foreign Currency (Transactional)</div>
                            <div class="col-sm-6"><strong>SWIFT:</strong> SBZAZAJJ</div>
                            <div class="col-sm-6"><strong>Currency:</strong> (EUR)</div>
                            <div class="col-sm-6"><strong>Name:</strong> Gift of the Givers Foundation</div>
                        </div>
                    </div>
                </div>

                <!-- Account 4: USD -->
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="fw-bold text-success">Gift of the Givers Foundation <span class="badge bg-info">USD</span></h5>
                        <div class="row">
                            <div class="col-sm-6"><strong>Account Number:</strong> 090710347</div>
                            <div class="col-sm-6"><strong>Bank:</strong> Standard Bank</div>
                            <div class="col-sm-6"><strong>Type:</strong> Foreign Currency (Transactional)</div>
                            <div class="col-sm-6"><strong>SWIFT:</strong> SBZAZAJJ</div>
                            <div class="col-sm-6"><strong>Currency:</strong> (USD)</div>
                            <div class="col-sm-6"><strong>Name:</strong> Gift of the Givers Foundation</div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<!-- MODAL 2: SCAN TO PAY                     -->
<div class="modal fade" id="scanModal" tabindex="-1" aria-labelledby="scanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold" id="scanModalLabel">Scan to Pay</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-4">
                <p class="text-muted">
                    Go to the Scan to Pay App on your smartphone to scan or enter this code
                </p>
                <!-- The barcode/code from your image -->
                <div class="bg-light p-4 rounded-4 border border-2 border-success d-inline-block mx-auto mb-2">
                    <span class="display-3 fw-bold tracking-tight" style="letter-spacing: 8px; font-family: 'Courier New', monospace;">
                        2965 1596 53
                    </span>
                </div>
                <p class="small text-muted">(or enter: <strong>2965159653</strong>)</p>
                <!-- Placeholder for a generated barcode image if you have one -->
                <div class="mt-3">
                    <span class="badge bg-secondary">📱 Scan with your banking app</span>
                </div>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL 3: LEAVE A LEGACY                 -->

<div class="modal fade" id="legacyModal" tabindex="-1" aria-labelledby="legacyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold" id="legacyModalLabel">Leave a Legacy</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <h2 class="fw-bold display-6 text-center">LEAVE A LEGACY</h2>
                <p class="text-center h5 text-muted">HELP THOSE IN NEED</p>
                <hr />

                <h5 class="fw-bold mt-4">Leaving Gift of the Givers as a Beneficiary in your Will.</h5>
                <p>
                    Gift of the Givers appreciates the importance of leaving a legacy to one's heirs.
                    Where the testator wishes to extend the remainder of the estate to beneficiaries
                    outside of their family, Gift of the Givers may be a suitable option and is willing
                    to accept items in kind, cash, shares, etc.
                </p>

                <div class="bg-light p-3 rounded-3 border-start border-4 border-success mt-3">
                    <p class="fw-bold mb-2">The following information may be shared with the executor:</p>
                    <ul class="list-unstyled mb-0">
                        <li><strong>Registration Name:</strong> Waqful Waqifin Foundation <span class="text-muted">(Translates to Gift of the Givers in English)</span></li>
                        <li><strong>NPO Number:</strong> 032-031</li>
                        <li><strong>PBO Number:</strong> PBO 930018993</li>
                        <li><strong>Address:</strong> 290 Prince Alfred Street, Pietermaritzburg, 3201</li>
                    </ul>
                </div>

                <div class="alert alert-info mt-3">
                    <i class="bi bi-envelope"></i> Further details may be acquired by emailing
                    <a href="mailto:info@giftofthegivers.org" class="fw-bold">info@giftofthegivers.org</a>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
</section>
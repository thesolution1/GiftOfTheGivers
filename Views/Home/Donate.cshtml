                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">

                <!-- Account 1: ZAR -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <h5 class="fw-bold text-success">Gift of the Givers Foundation</h5>
                        <div class="row">
                            <div class="col-sm-6"><strong>Account Number:</strong> 052137228</div>
                            <div class="col-sm-6"><strong>Bank:</strong> Standard Bank</div>
                            <div class="col-sm-6"><strong>Universal Code:</strong> 051001</div>
                            <div class="col-sm-6"><strong>SWIFT Code:</strong> SBZAZAJJ</div>

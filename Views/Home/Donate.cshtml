@model GiftOfTheGivers.Models.Donation

@{
    ViewData["Title"] = "Donate";
    ViewData["BackgroundImage"] = "/image/background.jpeg";
}

<section class="py-5">
    <div class="container">

        <!-- HEADER -->
        <div class="text-center mb-4">
            <h1 class="display-3 fw-bold text-uppercase text-dark">Make a Difference</h1>
            <p class="h4 text-muted fw-semibold">HELP THOSE IN NEED</p>
        </div>

        <!--DESCRIPTION -->
        <div class="row justify-content-center mb-5">
            <div class="col-lg-10">
                <div class="card border-0 bg-light p-4 shadow-sm">
                    <p class="mb-0" style="font-size: 1.05rem; line-height: 1.8;">
                        Gift of the Givers strives to uplift the most vulnerable and marginalised
                        communities through various humanitarian initiatives. Your contribution
                        goes a long way in helping us to benefit mankind and give back for the
                        greater good.
                        <br /><br />
                        <strong>
                            Donations to Gift of the Givers may qualify for a tax certificate as
                            per Section 18A, under the Income Tax Act.
                        </strong>
                        If you are a taxpayer in South Africa and require a tax certificate,
                        please email
                        <a href="mailto:donations@giftofthegivers.org" class="text-success fw-bold">
                            donations@giftofthegivers.org
                        </a>
                        together with your proof of donation.
                    </p>
                </div>
            </div>
        </div>

        <!--DONATION METHODS -->
        <div class="row g-4">
            <!--BANKING DETAILS-->
<div class="col-md-4">
    <div class="card border-0 shadow-sm h-100 text-center">
        <div class="card-body p-4 d-flex flex-column">
            <div class="mb-3">
                <i class="bi bi-bank fs-1 text-success"></i>
            </div>
            <h5 class="fw-bold">BANKING DETAILS</h5>
            <p class="text-muted small">Direct bank transfer or EFT donations.</p>
            <button type="button" class="btn btn-outline-dark mt-auto" data-bs-toggle="modal" data-bs-target="#bankingModal">
                View Details
            </button>
        </div>
    </div>
</div>

<!-- DONATE ONLINE -->
<div class="col-md-4">
    <div class="card border-0 shadow-sm h-100 text-center">
        <div class="card-body p-4 d-flex flex-column">
            <div class="mb-3">
                <i class="bi bi-credit-card fs-1 text-success"></i>
            </div>
            <h5 class="fw-bold">DONATE ONLINE</h5>
            <p class="text-muted small">Secure online payment via credit/debit card.</p>
            <a asp-controller="Donation" asp-action="Online" class="btn btn-success mt-auto">Donate Now</a>
        </div>
    </div>
</div>

<!--DONATE WITH SCAN TO PAY -->
<div class="col-md-4">
    <div class="card border-0 shadow-sm h-100 text-center">
        <div class="card-body p-4 d-flex flex-column">
            <div class="mb-3">
                <i class="bi bi-qr-code fs-1 text-success"></i>
            </div>
            <h5 class="fw-bold">DONATE WITH SCAN TO PAY</h5>
            <p class="text-muted small">Scan the QR code with your banking app.</p>
            <button type="button" class="btn btn-outline-dark mt-auto" data-bs-toggle="modal" data-bs-target="#scanModal">
                View QR Code
            </button>
        </div>
    </div>
</div>


<!-- 6. LEAVE A LEGACY - triggers modal -->
<div class="col-md-4">
    <div class="card border-0 shadow-sm h-100 text-center">
        <div class="card-body p-4 d-flex flex-column">
            <div class="mb-3">
                <i class="bi bi-heart fs-1 text-success"></i>
            </div>
            <h5 class="fw-bold">LEAVE A LEGACY</h5>
            <p class="text-muted small">Include Gift of the Givers in your will.</p>
            <button type="button" class="btn btn-outline-dark mt-auto" data-bs-toggle="modal" data-bs-target="#legacyModal">
                Plan Now
            </button>
        </div>
    </div>
</div>

        </div>
        <!-- End row -->

    </div>


<!-- MODAL 1: BANKING DETAILS                 -->

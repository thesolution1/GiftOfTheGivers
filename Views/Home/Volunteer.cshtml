@model GiftOfTheGivers.Models.Volunteer

@{
    ViewData["Title"] = "Volunteer";
    ViewData["BackgroundImage"] = "/image/background.jpeg";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="text-center mb-5">

                <span class="badge bg-warning text-dark px-3 py-2 mb-3">
                    VOLUNTEER
                </span>

                <h1 class="fw-bold">
                    Become a Volunteer
                </h1>

                <p class="text-muted">
                    Register your interest and help support
                    communities affected by disasters.
                </p>

            </div>

            @if (TempData["VolunteerSuccess"] != null)
            {
                <div class="alert alert-success text-center">
                    @TempData["VolunteerSuccess"]
                </div>
            }

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5">

                    <form asp-controller="Home"
                          asp-action="Volunteer"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="mb-3">

                            <label asp-for="Name"
                                   class="form-label fw-bold">
                                Full Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter your full name" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="Skills"
                                   class="form-label fw-bold">
                                Skills
                            </label>

                            <input asp-for="Skills"
                                   class="form-control"
                                   placeholder="e.g. First Aid, Driving, IT" />

                            <span asp-validation-for="Skills"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Availability"
                                   class="form-label fw-bold">
                                Availability
                            </label>

                            <select asp-for="Availability"
                                    class="form-select">

                                <option value="">
                                    Select availability
                                </option>

                                <option value="Weekdays">
                                    Weekdays
                                </option>

                                <option value="Weekends">
                                    Weekends
                                </option>

                                <option value="Full-Time">
                                    Full-Time
                                </option>

                                <option value="Part-Time">
                                    Part-Time
                                </option>

                            </select>

                            <span asp-validation-for="Availability"
                                  class="text-danger">
                            </span>

                        </div>

                        <button type="submit"
                                class="btn btn-dark w-100">

                            Register as Volunteer

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@{
    ViewData["Title"] = "Home";
    ViewData["BackgroundImage"] = "/image/home.jpeg";
}

<!-- Hero Section -->

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center min-vh-75">

            <div class="col-lg-7">

                <span class="badge bg-warning text-dark mb-3 px-3 py-2">
                    DISASTER RELIEF & HUMANITARIAN SUPPORT
                </span>

                <h1 class="display-3 fw-bold text-white">
                    Helping Communities
                    <span class="text-warning">
                        When They Need It Most
                    </span>
                </h1>

                <p class="lead text-white mt-4">
                    The Gift of the Givers Disaster Relief System
                    connects donors, volunteers and relief teams
                    to support communities affected by disasters.
                </p>

                <div class="mt-4">

                    <a asp-controller="Home"
                       asp-action="Donate"
                       class="btn btn-warning btn-lg me-2 px-4">
                        Donate Now
                    </a>

                    <a asp-controller="Volunteer"
                       asp-action="Index"
                       class="btn btn-outline-light btn-lg px-4">
                        Become a Volunteer
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- Login Options Section -->

<section class="py-5 bg-light">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="fw-bold">
                Access the Disaster Relief System
            </h2>

            <p class="text-muted">
                Select the appropriate login option to access your account.
            </p>

        </div>

        <div class="row g-4 justify-content-center">

            <!-- Donor / User Login -->

            <div class="col-md-5">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center p-5">

                        <div class="display-4 mb-3">
                            👤
                        </div>

                        <h3 class="fw-bold">
                            Donor / User Login
                        </h3>

                        <p class="text-muted">
                            For donors, volunteers and members of the
                            community who want to support disaster relief
                            activities.
                        </p>

                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           class="btn btn-warning btn-lg px-4">
                            User Login
                        </a>

                    </div>

                </div>

            </div>


            <!-- Employee / Admin Login -->

            <div class="col-md-5">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center p-5">

                        <div class="display-4 mb-3">
                            🛡️
                        </div>

                        <h3 class="fw-bold">
                            Employee / Admin Login
                        </h3>

                        <p class="text-muted">
                            For authorised employees who manage volunteers,
                            donations and disaster relief projects.
                        </p>

                        <a asp-controller="AdminLogin"
                           asp-action="Index"
                           class="btn btn-dark btn-lg px-4">
                            Admin Login
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- Employee Dashboard Statistics -->
@if (User.IsInRole("Employee"))
{
    <section class="py-5 bg-dark">

        <div class="container">

            <div class="text-center mb-5">

                <span class="badge bg-warning text-dark px-3 py-2 mb-3">
                    EMPLOYEE DASHBOARD
                </span>

                <h2 class="fw-bold text-white">
                    Relief System Statistics
                </h2>

                <p class="text-light">
                    Overview of volunteers, relief projects and donations.
                </p>

            </div>

            <div class="row g-4">

                <!-- Total Volunteers -->

                <div class="col-md-6 col-lg-3">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body text-center p-4">

                            <div class="display-5 mb-3">
                                👥
                            </div>

                            <h6 class="text-muted text-uppercase fw-bold">
                                Total Volunteers
                            </h6>

                            <h2 class="fw-bold text-success mb-0">
                                @ViewBag.TotalVolunteers
                            </h2>

                        </div>

                    </div>

                </div>


                <!-- Total Relief Projects -->

                <div class="col-md-6 col-lg-3">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body text-center p-4">

                            <div class="display-5 mb-3">
                                🚑
                            </div>

                            <h6 class="text-muted text-uppercase fw-bold">
                                Relief Projects
                            </h6>

                            <h2 class="fw-bold text-success mb-0">
                                @ViewBag.TotalReliefProjects
                            </h2>

                        </div>

                    </div>

                </div>


                <!-- Total Donations -->

                <div class="col-md-6 col-lg-3">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body text-center p-4">

                            <div class="display-5 mb-3">
                                💰
                            </div>

                            <h6 class="text-muted text-uppercase fw-bold">
                                Total Donations
                            </h6>

                            <h2 class="fw-bold text-success mb-0">
                                @ViewBag.TotalDonations
                            </h2>

                        </div>

                    </div>

                </div>


                <!-- Total ZAR Donations -->

                <div class="col-md-6 col-lg-3">

                    <div class="card border-0 shadow-sm h-100">

                        <div class="card-body text-center p-4">

                            <div class="display-5 mb-3">
                                🇿🇦
                            </div>

                            <h6 class="text-muted text-uppercase fw-bold">
                                Total ZAR Donations
                            </h6>

                            <h2 class="fw-bold text-success mb-0">
                                R @ViewBag.TotalZarDonations.ToString("N2")
                            </h2>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>
}


<!-- Serving Humanity Section -->

<section class="py-5">

    <div class="container">

        <!-- HEADER with Stats -->

        <div class="row align-items-center mb-5">

            <div class="col-md-7">

                <h2 class="fw-bold display-3 text-green"
                    style="font-size: 3.5rem;">
                    SERVING HUMANITY
                </h2>

                <p class="lead text-muted">
                    The Gift of the Givers Foundation is the largest disaster
                    response non-governmental organisation of African origin
                    on the African continent. The essence of our presence
                    is to bring hope and restore dignity to the most vulnerable.
                </p>

                <!-- Stats Row -->

                <div class="row mt-4 g-3">

                    <div class="col-4">

                        <h3 class="fw-bold text-success mb-0">
                            R6 Billion
                        </h3>

                        <small class="text-muted">
                            IN AID
                        </small>

                    </div>

                    <div class="col-4">

                        <h3 class="fw-bold text-success mb-0">
                            47
                        </h3>

                        <small class="text-muted">
                            PROJECTS / COUNTRIES
                        </small>

                    </div>

                    <div class="col-4">

                        <h3 class="fw-bold text-success mb-0">
                            33 Years
                        </h3>

                        <small class="text-muted">
                            OF SERVICE
                        </small>

                    </div>

                </div>

            </div>

            <div class="col-md-5">
                <!-- Optional image or extra content -->
            </div>

        </div>


        <!-- PRIMARY FOCUS CARDS -->

        <div class="row g-4">

            <!-- 1. Disaster Response -->

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center p-4">

                        <h4 class="fw-bold">
                            Disaster Response
                        </h4>

                        <p class="text-muted">
                            Rapid deployment of rescue teams, supplies,
                            and emergency relief to affected areas.
                        </p>

                        <a asp-controller="Home"
                           asp-action="Donate"
                           class="btn btn-dark">
                            Support Relief
                        </a>

                    </div>

                </div>

            </div>


            <!-- 2. Hunger Alleviation -->

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center p-4">

                        <h4 class="fw-bold">
                            Hunger Alleviation
                        </h4>

                        <p class="text-muted">
                            Distributing nutritious meals and food parcels
                            to combat malnutrition and famine.
                        </p>

                        <a asp-controller="Home"
                           asp-action="Donate"
                           class="btn btn-dark">
                            Donate Food
                        </a>

                    </div>

                </div>

            </div>


            <!-- 3. Water Provision -->

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center p-4">

                        <h4 class="fw-bold">
                            Water Provision
                        </h4>

                        <p class="text-muted">
                            Drilling boreholes and supplying clean drinking
                            water to drought-stricken communities.
                        </p>

                        <a asp-controller="Home"
                           asp-action="Donate"
                           class="btn btn-dark">
                            Give Water
                        </a>

                    </div>

                </div>

            </div>


            <!-- 4. Healthcare -->

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center p-4">

                        <h4 class="fw-bold">
                            Healthcare
                        </h4>

                        <p class="text-muted">
                            Mobile clinics, medical equipment, and
                            specialist care for underserved populations.
                        </p>

                        <a asp-controller="Home"
                           asp-action="Donate"
                           class="btn btn-dark">
                            Support Health
                        </a>

                    </div>

                </div>

            </div>


            <!-- 5. Education -->

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center p-4">

                        <h4 class="fw-bold">
                            Education
                        </h4>

                        <p class="text-muted">
                            Rebuilding schools, providing learning materials,
                            and funding scholarships.
                        </p>

                        <a asp-controller="Home"
                           asp-action="Donate"
                           class="btn btn-dark">
                            Support Education
                        </a>

                    </div>

                </div>

            </div>


            <!-- 6. Human Development -->

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center p-4">

                        <h4 class="fw-bold">
                            Human Development
                        </h4>

                        <p class="text-muted">
                            Skills training, psychosocial support,
                            and community empowerment programmes.
                        </p>

                        <a asp-controller="Home"
                           asp-action="Donate"
                           class="btn btn-dark">
                            Join Us
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- How You Can Help Section -->

<section class="py-5">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="fw-bold">
                How You Can Help
            </h2>

            <p class="text-muted">
                Every contribution can make a meaningful difference.
            </p>

        </div>

        <div class="row g-4">

            <!-- Donate -->

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center p-4">

                        <div class="display-5 mb-3">
                            💰
                        </div>

                        <h4 class="fw-bold">
                            Donate
                        </h4>

                        <p class="text-muted">
                            Support disaster-relief efforts through
                            one-time or recurring donations.
                        </p>

                        <a asp-controller="Home"
                           asp-action="Donate"
                           class="btn btn-dark">
                            Make a Donation
                        </a>

                    </div>

                </div>

            </div>


            <!-- Volunteer -->

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center p-4">

                        <div class="display-5 mb-3">
                            🤝
                        </div>

                        <h4 class="fw-bold">
                            Volunteer
                        </h4>

                        <p class="text-muted">
                            Register your skills and availability
                            to support relief operations.
                        </p>

                        <a asp-controller="Volunteer"
                           asp-action="Index"
                           class="btn btn-dark">
                            Volunteer Now
                        </a>

                    </div>

                </div>

            </div>


            <!-- Relief Projects -->

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center p-4">

                        <div class="display-5 mb-3">
                            🚑
                        </div>

                        <h4 class="fw-bold">
                            Relief Projects
                        </h4>

                        <p class="text-muted">
                            Follow updates from ongoing disaster
                            relief and humanitarian projects.
                        </p>

                        <a href="/Employee/Projects"
                           class="btn btn-dark">
                            View Projects
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- Impact Section -->

<section class="bg-light py-5">

    <div class="container">

        <div class="row text-center">

            <div class="col-md-4 mb-4 mb-md-0">

                <h2 class="fw-bold">
                    24/7
                </h2>

                <p class="text-muted">
                    Emergency Response
                </p>

            </div>

            <div class="col-md-4 mb-4 mb-md-0">

                <h2 class="fw-bold">
                    Global
                </h2>

                <p class="text-muted">
                    Humanitarian Support
                </p>

            </div>

            <div class="col-md-4">

                <h2 class="fw-bold">
                    Together
                </h2>

                <p class="text-muted">
                    Communities Making a Difference
                </p>

            </div>

        </div>

    </div>

</section>
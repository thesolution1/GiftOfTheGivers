@page
@model GiftOfTheGivers.Pages.Volunteers.IndexModel

@{
    ViewData["Title"] = "Volunteers";
    ViewData["BackgroundImage"] = "/image/background.jpeg";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Volunteers</h1>
            <p class="text-muted">Manage volunteer registrations.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="./Create" class="btn btn-success">New Volunteer</a>
            <a asp-controller="Employee" asp-action="Dashboard" class="btn btn-outline-dark">Back to Dashboard</a>
        </div>
    </div>

    <form method="get" class="row g-2 mb-3">
        <div class="col-auto">
            <input type="search" name="SearchString" value="@Model.SearchString" class="form-control" placeholder="Search name or skills" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-dark">Search</button>
            <a asp-page="./Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </form>

    @if (!Model.Volunteers.Any())
    {
        <div class="alert alert-info">No volunteers found.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Full Name</th>
                                <th>Skills</th>
                                <th>Availability</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model.Volunteers)
                            {
                                <tr>
                                    <td>@v.VolunteerID</td>
                                    <td>@v.Name</td>
                                    <td>@v.Skills</td>
                                    <td>@v.Availability</td>
                                    <td class="text-end">
                                        <a asp-page="./Details" asp-route-id="@v.VolunteerID" class="btn btn-sm btn-outline-primary me-1">View</a>
                                        <a asp-page="./Edit" asp-route-id="@v.VolunteerID" class="btn btn-sm btn-outline-warning me-1">Edit</a>
                                        <a asp-page="./Delete" asp-route-id="@v.VolunteerID" class="btn btn-sm btn-outline-danger">Delete</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
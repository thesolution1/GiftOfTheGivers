@page
@model GiftOfTheGivers.Pages.Volunteers.CreateModel

@{
    ViewData["Title"] = "Create Volunteer";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h3 class="mb-4">New Volunteer</h3>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Volunteer.Name" class="form-label fw-bold">Full Name</label>
                    <input asp-for="Volunteer.Name" class="form-control" />
                    <span asp-validation-for="Volunteer.Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Volunteer.Skills" class="form-label fw-bold">Skills</label>
                    <input asp-for="Volunteer.Skills" class="form-control" />
                    <span asp-validation-for="Volunteer.Skills" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Volunteer.Availability" class="form-label fw-bold">Availability</label>
                    <select asp-for="Volunteer.Availability" class="form-select">
                        <option value="">Select availability</option>
                        <option>Weekdays</option>
                        <option>Weekends</option>
                        <option>Full-Time</option>
                        <option>Part-Time</option>
                        <option>Emergency Only</option>
                    </select>
                    <span asp-validation-for="Volunteer.Availability" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success">Create</button>
                <a asp-page="./Index" class="btn btn-outline-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>
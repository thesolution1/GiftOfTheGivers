@page "{id:int}"
@model GiftOfTheGivers.Pages.Volunteers.DetailsModel

@{
    ViewData["Title"] = "Volunteer Details";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h3 class="mb-4">Volunteer Details</h3>

            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@Model.Volunteer.VolunteerID</dd>

                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.Volunteer.Name</dd>

                <dt class="col-sm-3">Skills</dt>
                <dd class="col-sm-9">@Model.Volunteer.Skills</dd>

                <dt class="col-sm-3">Availability</dt>
                <dd class="col-sm-9">@Model.Volunteer.Availability</dd>
            </dl>

            <a asp-page="./Edit" asp-route-id="@Model.Volunteer.VolunteerID" class="btn btn-warning">Edit</a>
            <a asp-page="./Index" class="btn btn-outline-secondary ms-2">Back</a>
        </div>
    </div>
</div>
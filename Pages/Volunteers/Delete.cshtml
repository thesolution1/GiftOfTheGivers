@page "{id:int}"
@model GiftOfTheGivers.Pages.Volunteers.DeleteModel

@{
    ViewData["Title"] = "Delete Volunteer";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h3 class="mb-4 text-danger">Delete Volunteer</h3>

            <p>Are you sure you want to delete the following volunteer?</p>

            <dl class="row">
                <dt class="col-sm-3">Full Name</dt>
                <dd class="col-sm-9">@Model.Volunteer.Name</dd>

                <dt class="col-sm-3">Skills</dt>
                <dd class="col-sm-9">@Model.Volunteer.Skills</dd>

                <dt class="col-sm-3">Availability</dt>
                <dd class="col-sm-9">@Model.Volunteer.Availability</dd>
            </dl>

            <form method="post" class="d-inline">
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>

            <a asp-page="./Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </div>
    </div>
</div>
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center min-vh-75">

            <div class="col-lg-7">

                <span class="badge bg-warning text-dark mb-3 px-3 py-2">
                    DISASTER RELIEF & HUMANITARIAN SUPPORT
                </span>

                <h1 class="display-3 fw-bold text-white">
                    Helping Communities
                    <span class="text-warning">
                        When They Need It Most
                    </span>
                </h1>

                <p class="lead text-white mt-4">
                    The Gift of the Givers Disaster Relief System
                    connects donors, volunteers and relief teams
                    to support communities affected by disasters.
                </p>

                <div class="mt-4">

                    <a asp-controller="Home"
                       asp-action="Donate"
                       class="btn btn-warning btn-lg me-2 px-4">
                        Donate Now
                    </a>

                    <a asp-controller="Volunteer"
                       asp-action="Index"
                       class="btn btn-outline-light btn-lg px-4">
                        Become a Volunteer
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- Services -->

<section class="py-5">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="fw-bold">
                How You Can Help
            </h2>

            <p class="text-muted">
                Every contribution can make a meaningful difference.
            </p>

        </div>

        <div class="row g-4">

            <!-- Donate -->

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center p-4">

                        <div class="display-5 mb-3">
                            💰
                        </div>

                        <h4 class="fw-bold">
                            Donate
                        </h4>

                        <p class="text-muted">
                            Support disaster-relief efforts through
                            one-time or recurring donations.
                        </p>

                        <a asp-controller="Home"
                           asp-action="Donate"
                           class="btn btn-dark">
                            Make a Donation
                        </a>

                    </div>

                </div>

            </div>


            <!-- Volunteer -->

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center p-4">

                        <div class="display-5 mb-3">
                            🤝
                        </div>

                        <h4 class="fw-bold">
                            Volunteer
                        </h4>

                        <p class="text-muted">
                            Register your skills and availability
                            to support relief operations.
                        </p>

                        <a asp-controller="Volunteer"
                           asp-action="Index"
                           class="btn btn-dark">
                            Volunteer Now
                        </a>

                    </div>

                </div>

            </div>


            <!-- Relief Projects -->

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body text-center p-4">

                        <div class="display-5 mb-3">
                            🚑
                        </div>

                        <h4 class="fw-bold">
                            Relief Projects
                        </h4>

                        <p class="text-muted">
                            Follow updates from ongoing disaster
                            relief and humanitarian projects.
                        </p>

                        <a href="/Employee/Projects"
                           class="btn btn-dark">
                            View Projects
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- Impact Section -->

<section class="bg-light py-5">

    <div class="container">

        <div class="row text-center">

            <div class="col-md-4 mb-4 mb-md-0">

                <h2 class="fw-bold">
                    24/7
                </h2>

                <p class="text-muted">
                    Emergency Response
                </p>

            </div>

            <div class="col-md-4 mb-4 mb-md-0">

                <h2 class="fw-bold">
                    Global
                </h2>

                <p class="text-muted">
                    Humanitarian Support
                </p>

            </div>

            <div class="col-md-4">

                <h2 class="fw-bold">
                    Together
                </h2>

                <p class="text-muted">
                    Communities Making a Difference
                </p>

            </div>

        </div>

    </div>

</section>
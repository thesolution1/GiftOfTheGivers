@{
    ViewData["Title"] = "About";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">About Gift of the Givers</h1>
        <p class="lead text-muted">
            Supporting communities through disaster relief and humanitarian assistance.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body p-4">
                    <h3 class="fw-bold">Our Mission</h3>
                    <p>
                        The Gift of the Givers Disaster Relief System is designed
                        to support humanitarian operations by connecting donors,
                        volunteers and relief projects through one accessible
                        digital platform.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body p-4">
                    <h3 class="fw-bold">Our Focus</h3>
                    <p>
                        The platform focuses on coordinating donations,
                        volunteer registrations and disaster-relief projects
                        while providing a simple and responsive experience
                        for users.
                    </p>
                </div>
            </div>
        </div>

    </div>

</div>


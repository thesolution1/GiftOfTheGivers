@model GiftOfTheGivers.Models.ReliefProject

@{
    ViewData["Title"] = "Post Relief Project Update";
}

<div class="container mt-4">

    <div class="text-center mb-4">
        <h1>Post Relief Project Update</h1>

        <p class="lead text-muted">
            Share important updates about ongoing disaster-relief projects.
        </p>
    </div>

    <div class="card shadow-sm">

        <div class="card-body p-4">

            <form asp-action="CreateProject" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="ProjectName"
                           class="form-label">
                        Project Name
                    </label>

                    <input asp-for="ProjectName"
                           class="form-control"
                           placeholder="e.g. Limpopo Flood Relief" />

                    <span asp-validation-for="ProjectName"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Location"
                           class="form-label">
                        Location
                    </label>

                    <input asp-for="Location"
                           class="form-control"
                           placeholder="e.g. Limpopo, South Africa" />

                    <span asp-validation-for="Location"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="Update"
                           class="form-label">
                        Project Update
                    </label>

                    <textarea asp-for="Update"
                              class="form-control"
                              rows="6"
                              placeholder="Enter the latest project update..."></textarea>

                    <span asp-validation-for="Update"
                          class="text-danger">
                    </span>
                </div>

                <button type="submit"
                        class="btn btn-dark">
                    Post Update
                </button>

                <a href="/Employee/Dashboard"
                   class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>